{
  "appId": "com.transcriptor.app",
  "productName": "Transcriptor",
  "directories": {
    "output": "release/full"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "python/dist/whisper-worker/",
      "to": "whisper-worker",
      "filter": ["**/*"]
    },
    {
      "from": "vendor/ffmpeg/",
      "to": "ffmpeg",
      "filter": ["ffmpeg.exe"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico"
  }
}
